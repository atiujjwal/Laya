          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Morning Meditation - Extended\",\n  \"description\": \"15 minutes of daily meditation with focus on breathing\",\n  \"targetValue\": 15,\n  \"unit\": \"minutes\",\n  \"frequency\": \"DAILY\",\n  \"weekDays\": [0, 1, 2, 3, 4, 5, 6]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/habits/{{habit_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "habits",
                "{{habit_id}}"
              ]
            },
            "description": "Update habit configuration",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"habit_title\", jsonData.title);",
                    "    console.log('Habit updated: ' + jsonData.title);",
                    "}"
                  ],
                  "type": "text/javascript",
                  "id": "update-habit-test"
                }
              }
            ]
          },
          "response": []
