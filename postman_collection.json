                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/planner?date=2026-01-21",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "planner"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-01-21"
                }
              ]
            },
            "description": "Retrieve AI-generated daily plan for a specific date"
          },
          "response": []
        },
        {
          "name": "Generate AI Daily Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
