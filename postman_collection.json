              "mode": "raw",
              "raw": "{\n  \"title\": \"Morning Meditation\",\n  \"description\": \"10 minutes of daily meditation to start the day\",\n  \"color\": \"#8B5CF6\",\n  \"icon\": \"🧘\",\n  \"frequency\": \"DAILY\",\n  \"weekDays\": [0, 1, 2, 3, 4, 5, 6],\n  \"targetValue\": 1,\n  \"unit\": \"session\"\n}"
