                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/habits/{{habit_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "habits",
                "{{habit_id}}"
              ]
            },
            "description": "Archive a habit (soft delete - preserves historical logs)"
          },
          "response": []
        }
      ]
