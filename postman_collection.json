    {
      "name": "📊 Habit Logging",
      "item": [
        {
          "name": "Log Habit Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habitId\": \"{{habit_id}}\",\n  \"date\": \"2026-01-21T00:00:00Z\",\n  \"value\": 15,\n  \"completed\": true,\n  \"meta\": {\n    \"mood\": \"Happy\",\n    \"weather\": \"Sunny\",\n    \"notes\": \"Felt refreshed and energized\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/habits/log",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "habits",
                "log"
              ]
            },
            "description": "Log a habit completion with optional metadata (mood, notes, etc.)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"log_id\", jsonData.id);",
                    "    console.log('Habit logged for date: ' + jsonData.date);",
                    "}"
                  ],
                  "type": "text/javascript",
                  "id": "log-habit-test"
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Get Habit Logs (Date Range)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/habits/logs?startDate=2026-01-01T00:00:00Z&endDate=2026-01-31T23:59:59Z",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "habits",
                "logs"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-01-01T00:00:00Z"
                },
                {
                  "key": "endDate",
                  "value": "2026-01-31T23:59:59Z"
                }
              ]
            },
            "description": "Retrieve habit logs within a specified date range"
          },
          "response": []
        }
      ]
