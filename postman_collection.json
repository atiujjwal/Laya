  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"user@example.com\",\n  \"type\": \"email\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "otp"
              ]
            },
            "description": "Generate and send OTP to user's email or mobile"
          },
          "response": []
        },
        {
          "name": "NextAuth Handler",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/[...nextauth]",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "[...nextauth]"
              ]
            },
            "description": "Standard NextAuth authentication endpoint"
          },
          "response": []
        }
      ]
    },
    {
      "name": "👤 User Profile",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "profile"
              ]
            },
            "description": "Retrieve current user profile information"
          },
          "response": []
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"timezone\": \"America/New_York\",\n  \"onboarding\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "profile"
              ]
            },
            "description": "Update user profile settings",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"user_id\", jsonData.id);",
                    "    pm.environment.set(\"user_name\", jsonData.name);",
                    "    pm.environment.set(\"user_timezone\", jsonData.timezone);",
                    "}"
                  ],
                  "type": "text/javascript",
                  "id": "profile-update-test"
                }
              }
            ]
          },
          "response": []
        }
      ]
    },
    {
      "name": "📋 Goals Management",
      "item": [
        {
          "name": "List All Goals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/goals?completed=false&category=Health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "goals"
              ],
              "query": [
                {
                  "key": "completed",
                  "value": "false",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "Health",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieve all goals with optional filtering by completion status and category"
          },
          "response": []
        },
        {
          "name": "Create New Goal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete AWS Certification\",\n  \"category\": \"Career\",\n  \"targetDate\": \"2026-06-30T23:59:59Z\",\n  \"steps\": [\n    {\n      \"step\": \"Complete Module 1: Cloud Fundamentals\",\n      \"done\": false\n    },\n    {\n      \"step\": \"Complete Module 2: Compute Services\",\n      \"done\": false\n    },\n    {\n      \"step\": \"Take practice exams\",\n      \"done\": false\n    },\n    {\n      \"step\": \"Schedule and pass final exam\",\n      \"done\": false\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/goals",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "goals"
              ]
            },
            "description": "Create a new goal with steps",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"goal_id\", jsonData.id);",
                    "    pm.environment.set(\"goal_title\", jsonData.title);",
                    "    console.log('Goal created with ID: ' + jsonData.id);",
                    "}"
                  ],
                  "type": "text/javascript",
                  "id": "create-goal-test"
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Update Goal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete AWS Certification - Updated\",\n  \"progress\": 50,\n  \"completed\": false,\n  \"steps\": [\n    {\n      \"step\": \"Complete Module 1: Cloud Fundamentals\",\n      \"done\": true\n    },\n    {\n      \"step\": \"Complete Module 2: Compute Services\",\n      \"done\": true\n    },\n    {\n      \"step\": \"Take practice exams\",\n      \"done\": false\n    },\n    {\n      \"step\": \"Schedule and pass final exam\",\n      \"done\": false\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/goals/{{goal_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "goals",
                "{{goal_id}}"
              ]
            },
            "description": "Update an existing goal",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"goal_progress\", jsonData.progress);",
                    "    console.log('Goal updated: ' + jsonData.title);",
                    "}"
                  ],
                  "type": "text/javascript",
                  "id": "update-goal-test"
                }
              }
            ]
          },
          "response": []
        }
      ]
    },
    {
      "name": "🎯 Habits Management",
