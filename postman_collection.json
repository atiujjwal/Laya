            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-01-22T00:00:00Z\",\n  \"focus\": \"Complete project deadlines and maintain meditation routine\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/planner/generate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "planner",
                "generate"
              ]
            },
            "description": "Generate an AI-powered daily plan based on user's habits and goals",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"plan_id\", jsonData.id);",
                    "    pm.environment.set(\"day_score\", jsonData.dayScore);",
                    "    console.log('Plan generated with score: ' + jsonData.dayScore);",
                    "}"
                  ],
                  "type": "text/javascript",
                  "id": "generate-plan-test"
                }
              }
            ]
          },
          "response": []
